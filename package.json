{
  "name": "gravit-showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sizes": "node scripts/file-sizes.mjs",
    "predev": "npm run sizes",
    "dev": "vite",
    "prebuild": "npm run sizes",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
